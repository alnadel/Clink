{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist-e2e",
      "!**/dist",
      "!**/coverage",
      "!apps/web/public/content",
      "!content",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/rules/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pixi.js": "packages/rules must not import UI code (NFR-14).",
                  "preact": "packages/rules must not import UI code (NFR-14).",
                  "idb-keyval": "packages/rules must not do I/O.",
                  "node:fs": "packages/rules must not do I/O.",
                  "node:path": "packages/rules must not do I/O."
                }
              }
            }
          }
        }
      }
    }
  ]
}
