{
  "name": "clink",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --filter @clink/web dev",
    "build": "pnpm --filter @clink/web build",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build && node scripts/check-no-test-hook.mjs && pnpm size",
    "levels:check": "tsx packages/content-tools/src/cli/check.ts",
    "levels:prove": "tsx packages/content-tools/src/cli/prove.ts",
    "packs:build": "tsx packages/content-tools/src/cli/packs.ts",
    "levels:gen": "tsx packages/content-tools/src/cli/gen.ts",
    "test:e2e": "pnpm --filter @clink/web exec playwright test",
    "content:seed": "tsx packages/content-tools/src/cli/seed.ts",
    "test:coverage": "pnpm --filter @clink/rules test:coverage",
    "size": "node scripts/check-size.mjs",
    "test:e2e:full": "E2E_FULL=1 pnpm --filter @clink/web exec playwright test full"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
